# Kopyalayın: cp .env.example .env  — ardından docker compose up -d

# Arayüz portu (host ağı kullanıldığı için doğrudan makinenin portu)
PORT=8080

# Yönetici şifresi (boş bırakılırsa arayüz şifresiz açılır — önerilmez)
ADMIN_PASSWORD=
# Oturum çerezlerini imzalamak için rastgele uzun bir değer: openssl rand -hex 32
SECRET_KEY=change-me

# Taranacak ağlar (virgülle). Boşsa bağlı ağ otomatik tespit edilir.
# Ör: SUBNETS=192.168.1.0/24,192.168.20.0/24
SUBNETS=

# Saat dilimi (arayüz ve zamanlanmış işler)
TZ=Europe/Istanbul

# Bildirimler (Apprise formatı, virgülle ayrılmış). Ayarlar sayfasından da düzenlenebilir.
# Telegram:  tgram://BOT_TOKEN/CHAT_ID
# Gmail:     mailtos://kullanici:uygulama-sifresi@gmail.com?to=ben@ornek.com
# ntfy:      ntfy://ntfy.sh/benim-konum
APPRISE_URLS=

# Aşağıdakiler yalnızca ilk varsayılanlardır; Ayarlar sayfasından değiştirilebilir.
QUICK_INTERVAL_MIN=5
DEEP_INTERVAL_HOURS=24
TOP_PORTS=1000
SCAN_CONCURRENCY=4
ENABLE_VULNERS=true
ENABLE_WATCHDOG=true
DHCP_PROBE_INTERVAL_MIN=60
NOTIFY_ON_LEAVE=false
